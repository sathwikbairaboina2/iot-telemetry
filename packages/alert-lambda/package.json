    "@aws-sdk/client-sns": "3.1146.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "8.3.2"
  }
}
