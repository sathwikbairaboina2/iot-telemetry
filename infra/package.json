{
  "name": "@iot-telemetry/infra",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "vitest run .int.test --passWithNoTests",
    "synth": "pnpm --filter @iot-telemetry/alert-lambda run bundle && cdk synth --quiet --no-notices"
  },
  "dependencies": {
    "@iot-telemetry/schema": "workspace:*",
    "aws-cdk-lib": "2.272.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "aws-cdk": "2.1144.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
